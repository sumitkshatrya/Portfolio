# =========================================================
# Portfolio AI Assistant Environment Configuration Example
# Copy this file to .env and provide your actual API keys.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# =========================================================


PORT=5000

# Google Gemini API Key (Required for AI responses)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: MongoDB URI for telemetry and chat analytics
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_DB_NAME=portfolio

